{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:generate": "npm run openapi:export -w api && openapi-ts -i ../api/openapi.json -o src/lib/api/generated -c @hey-api/client-fetch",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide --emit-ts-declarations --no-emit-git-ignore --output-structure locale-modules",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "guardrails": "node ../scripts/guardrails/check-frontend-guardrails.mjs",
    "lint-ci": "npm run type-check && eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run guardrails && npm run lint-ci && npm test"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.4.0",
    "@mantine/core": "9.3.0",
    "@mantine/dropzone": "9.3.0",
    "@mantine/form": "9.3.0",
    "@mantine/hooks": "9.3.0",
    "@mantine/modals": "9.3.0",
    "@mantine/notifications": "9.3.0",
    "@mantine/tiptap": "9.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "papaparse": "^5.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@inlang/plugin-message-format": "^4.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
