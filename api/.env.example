# App
PORT=3000
APP_ENV=dev

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=api

JWT_SECRET=secret

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

LOG_LEVEL=debug

# Mail
MAIL_FROM=no-reply@nestjs-starter-kit.smtp.com
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_AUTH_USER=any-user
MAIL_AUTH_PASS=any-password

# Local uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760

# Auto-translation
AUTO_TRANSLATION_ENABLED=false
AUTO_TRANSLATION_PROVIDER=deepl
DEEPL_AUTH_KEY=
DEEPL_TARGET_EN_VARIANT=en-US
AUTO_TRANSLATION_MAX_FIELD_BYTES=100000

RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_ADMIN_WRITE_WINDOW_MS=60000
RATE_LIMIT_ADMIN_WRITE_MAX=60
