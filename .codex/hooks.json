{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-context-summary.mjs\"",
            "timeout": 30,
            "statusMessage": "Loading project context summary"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/prompt-doc-router.mjs\"",
            "timeout": 30,
            "statusMessage": "Routing prompt to project docs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/block-dev-build-commands.mjs\"",
            "timeout": 30,
            "statusMessage": "Blocking dev/build commands unless explicit"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guardrails.mjs\" --pre",
            "timeout": 30,
            "statusMessage": "Checking project guardrails before edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guardrails.mjs\" --post",
            "timeout": 30,
            "statusMessage": "Checking project guardrails after edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guardrails.mjs\" --stop",
            "timeout": 30,
            "statusMessage": "Final project guardrail check"
          }
        ]
      }
    ]
  }
}
